{"nodes": [{"id": "structure_layora_architecture", "label": "Layora Architecture & System Structure", "file_type": "document", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "structure_state_synchronization_pipeline", "label": "State Synchronization Pipeline (cloud-wins)", "file_type": "concept", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Store changes are intercepted by SyncProvider, debounced, and queued for sequential upserts to POST /api/user/state so concurrent writes cannot race or land out of order. Hydration uses GET /api/user/state with the Clerk auth() identity; a user with a `users` row but no `user_states` row gets a default onboarded state synthesized server-side."}, {"id": "structure_gamification_points_ledger", "label": "Gamification & Points Ledger Pipeline", "file_type": "concept", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deltas come from comparing current platform totals against the closest historical baseline row in daily_activities, then are logged idempotently. Points: LeetCode Easy +10 / Medium +20 / Hard +35, CodeChef +15 per solve, GitHub commits +0 (streak telemetry only)."}, {"id": "structure_sync_logic", "label": "syncLogic.ts (activity aggregator & points calculator)", "file_type": "code", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "structure_cron_daily_sync", "label": "/api/cron/daily-sync (scheduled activity sync)", "file_type": "code", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "structure_api_ai_planner", "label": "/api/ai/planner (weekly timetable generator)", "file_type": "code", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compiles class times, subjects, tasks and courses into a structured prompt for Groq Llama 3.1 8B, which returns a JSON timetable block array plus scheduling insights."}, {"id": "structure_api_ai_proactive", "label": "/api/ai/proactive (AI academic mentor)", "file_type": "code", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "structure_duality_rule", "label": "Duality Rule (task + timetable block bound together)", "file_type": "rationale", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scheduling a study task always produces both a checkable Task and a Timetable block, bound in the store, so completion state and calendar placement never drift apart."}, {"id": "structure_api_calendar_sync", "label": "/api/calendar/sync (Google Calendar push)", "file_type": "code", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retrieves the Google OAuth access token from Clerk rather than holding its own credentials, then pushes study blocks to the student's primary calendar."}, {"id": "structure_api_resources_upload_drive", "label": "/api/resources/upload-drive (Google Drive proxy upload)", "file_type": "code", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "structure_api_user_state", "label": "/api/user/state (secure Supabase state proxy)", "file_type": "code", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "structure_api_user_purge", "label": "/api/user/purge (data purge)", "file_type": "code", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deletes user_states metadata, drops daily_activities references, and removes the users row in one transactional sequence so no orphan telemetry survives."}, {"id": "structure_clerk_middleware", "label": "Clerk Middleware (route protection & token check)", "file_type": "code", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "structure_security_model", "label": "Security & Protection Model", "file_type": "concept", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four pillars: zero client-side DB calls (the anon key path is disabled on the frontend), server-side authorization on every route via awaited auth() plus owner-or-isAdminEmail checks, parameterized queries only through the Supabase query builder (no string interpolation, neutralizing SQLi), and transactional data purging."}, {"id": "structure_is_admin_email", "label": "isAdminEmail admin allowlist", "file_type": "code", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "structure_supabase_admin_service_role", "label": "supabaseAdmin service-role client (RLS bypass)", "file_type": "code", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server routes use the service role to bypass RLS, which is safe only because every route has already verified the caller's userId owns the target row."}, {"id": "structure_table_users", "label": "users table", "file_type": "concept", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "structure_table_daily_activities", "label": "daily_activities table", "file_type": "concept", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "structure_table_user_states", "label": "user_states table (serialized Zustand state jsonb)", "file_type": "concept", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "structure_table_certificates", "label": "certificates table & Supabase Storage bucket", "file_type": "concept", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Certificates are the one file class Layora does store; deletion is restricted to objects prefixed with the caller's verified userId."}, {"id": "structure_leetcode_graphql", "label": "LeetCode GraphQL stats source", "file_type": "concept", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "structure_codechef_scraper", "label": "CodeChef solve-count scraper", "file_type": "concept", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No public API for total solves, so the public user stats page is scraped."}, {"id": "structure_github_events_api", "label": "GitHub Events API source", "file_type": "concept", "source_file": "structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "structure_layora_architecture", "target": "structure_state_synchronization_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "struct