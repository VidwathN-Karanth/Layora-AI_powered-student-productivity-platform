{"nodes": [{"id": "readme_layora", "label": "Layora: Autonomous AI Student Productivity Suite", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_server_side_database_proxy", "label": "Server-Side Database Proxy (/api/user/state)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-side privacy blockers (uBlock Origin, Privacy Badger, corporate firewalls) intercept direct Supabase connections. Routing all queries through a same-origin serverless route is never blocked, resolves the Clerk user ID from server session headers, and bypasses browser CORS and extension blocking entirely."}, {"id": "readme_client_write_timestamp_queue", "label": "Client Write-Timestamp Queue (anti-race-condition)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Realtime websocket callbacks fired by DB updates occasionally overwrote fresher local changes, making subjects and files vanish. Every write payload carries a clientTimestamp and the client keeps a ref of its last local write; incoming echoes with an older-or-equal timestamp are ignored, killing stale echoes while preserving multi-device sync."}, {"id": "readme_vercel_size_guard", "label": "Vercel 4.5MB Upload Size Guard", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct file proxying passes through Vercel serverless, which caps request bodies at 4.5MB. The UI validates size up front, warns, and locks uploads; larger files are instead indexed via the Web Link tab after a manual Drive upload."}, {"id": "readme_drive_weblink_fallback", "label": "Google Drive webViewLink Fallback Construction", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Google's upload response sometimes omits webViewLink, so the backend synthesizes https://drive.google.com/file/d/[id]/view?usp=drivesdk from the returned file ID to guarantee every resource stays viewable."}, {"id": "readme_no_supabase_file_storage", "label": "No Study Materials on Supabase Storage (privacy stance)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User PDFs and study materials are written straight to the student's own Google Drive and never pass through or rest on Layora-controlled storage, so Layora holds no user documents."}, {"id": "readme_generative_timetable_compiler", "label": "Generative Timetable Compiler", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pairs a Groq-LLM online scheduler with a local offline fallback algorithm so timetable generation still succeeds when the AI call fails or no key is present."}, {"id": "readme_local_demo_mode", "label": "Local Demo Mode (missing Supabase keys fallback)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If Supabase credentials are blank the app degrades to local-only state and shows an explicit warning banner, so a developer is never confused by settings silently resetting on refresh."}, {"id": "readme_row_level_security", "label": "Supabase Row-Level Security Isolation", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RLS ties each row to the owning Clerk user account so no profile can be read, updated or deleted by another identity."}, {"id": "readme_onboarding_portal", "label": "Onboarding Portal (7-step routine wizard)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_workspace_dashboard", "label": "Main Workspace Dashboard", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_milestone_tracker_stopwatch", "label": "Milestone Tracker & Global Stopwatch", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The stopwatch lives at the top of the dashboard shell so it persists across page navigation; completing a task feeds study hours, stats and streak multipliers."}, {"id": "readme_resource_vault", "label": "Resource Vault", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_online_course_tracker", "label": "Online Course Tracker", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_study_copilot", "label": "Study Copilot (LLM assistant)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supports user-supplied Groq API keys stored in the profile so students can use their own quota."}, {"id": "readme_admin_root_console", "label": "Admin Root Console", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sync_provider", "label": "SyncProvider (Zustand synchronizer & realtime listener)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_groq_api", "label": "Groq API (LLM inference)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_clerk_auth", "label": "Clerk Authentication", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_google_calendar_sync", "label": "Google Calendar Sync", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_layora", "target": "readme_server_side_database_proxy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_layora", "target": "readme_client_write_timestamp_queue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_layora", "target": "readme_generative_timetable_compiler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_server_side_database_proxy", "target": "readme_clerk_auth", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_sync_provider", "target": "readme_client_write_timestamp_queue", "relation": "implements", "co