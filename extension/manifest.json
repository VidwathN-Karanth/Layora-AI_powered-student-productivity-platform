{
  "manifest_version": 3,
  "name": "Layora Quick Access",
  "version": "1.0.0",
  "description": "Your Layora quick launchers and courses, one click from any tab.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Layora Quick Access"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://layora239.vercel.app/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://layora239.vercel.app/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://layora239.vercel.app/extension*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
